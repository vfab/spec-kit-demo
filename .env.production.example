# Production environment variables for ShopHub
# Copy this file to .env.production and fill in all values before deploying.
# NEVER commit .env.production to version control.
#
# For Fly.io, set secrets via:
#   flyctl secrets set SECRET_KEY="..." DATABASE_URL="..." --app shophub-staging

# ── Django Core ────────────────────────────────────────────────────────────────

# Django secret key — generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# PostgreSQL connection string
# Example: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=

# Comma-separated list of allowed hostnames (no spaces)
# Example: shophub.fly.dev,www.shophub.com
ALLOWED_HOSTS=

# Django settings module — must be the production settings
DJANGO_SETTINGS_MODULE=ecommerce_site.settings_production

# Port the application listens on (Fly.io sets this automatically)
PORT=8000

# ── Security ───────────────────────────────────────────────────────────────────

# Set to True in production (handled by settings_production.py automatically)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# ── Static Files (WhiteNoise) ──────────────────────────────────────────────────
# No additional configuration required — WhiteNoise is configured automatically
# in settings_production.py via STATICFILES_STORAGE.

# ── Backup Storage (Cloudflare R2) ────────────────────────────────────────────

# Cloudflare R2 bucket name for database backups
R2_BUCKET=

# Cloudflare R2 endpoint URL
# Example: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# Cloudflare R2 API credentials (use R2 API tokens, not account-level keys)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Optional Feature Flags ────────────────────────────────────────────────────

# Number of Gunicorn worker processes (default: 3)
# GUNICORN_WORKERS=3

# Session cookie lifetime in seconds (default: 7200 = 2 hours)
# SESSION_COOKIE_AGE=7200

# Account lockout failure limit (default: 5)
# AXES_FAILURE_LIMIT=5

# Slow query logging threshold in milliseconds (default: 100)
# DB_SLOW_QUERY_MS=100

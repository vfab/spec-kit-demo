# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# Required — generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=True

# Comma-separated — add your domain in production (e.g. myapp.fly.dev)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (SQLite default; swap for postgres://user:pass@host:5432/db in production)
DATABASE_URL=sqlite:///db.sqlite3
# Keep connections open across requests (seconds). Use 0 for SQLite, 60+ for Postgres.
DB_CONN_MAX_AGE=0

# Email (console backend for dev; configure SMTP in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Static / media URLs
STATIC_URL=/static/
MEDIA_URL=/media/

# Security headers (set True in production)
SECURE_BROWSER_XSS_FILTER=True

# Feature flags (set True to enable a feature in this environment)
FEATURE_REVIEWS=False
FEATURE_WISHLIST=False
FEATURE_DISCOUNT_CODES=False

# Gunicorn workers (production only — ignored by runserver)
GUNICORN_WORKERS=3

SECURE_CONTENT_TYPE_NOSNIFF=True
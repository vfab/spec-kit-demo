# Production environment settings
# Populate these in your hosting platform's secrets / environment manager.
# NEVER commit real values of this file — treat it as a template only.

# ── Core ──────────────────────────────────────────────────────────────────────
# Required — generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=REPLACE_WITH_STRONG_SECRET_KEY

DEBUG=False
# Comma-separated list of your domain(s)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL — recommended for production
DATABASE_URL=postgres://user:password@db-host:5432/shophub_prod
# Keep connections open across requests (seconds); 0 = close after every request
DB_CONN_MAX_AGE=60

# ── Email ────────────────────────────────────────────────────────────────────
# SMTP — configure for your mail provider (SendGrid, SES, Postmark, etc.)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ── Static / media ───────────────────────────────────────────────────────────
STATIC_URL=/static/
MEDIA_URL=/media/
# If using S3/CloudFront, set STATIC_URL and MEDIA_URL to CDN URLs

# ── Business logic ───────────────────────────────────────────────────────────
TAX_RATE=0.08
MAX_IMAGE_UPLOAD_MB=5

# ── Security (enforce HTTPS) ─────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# 1 year HSTS; only enable once you are confident your domain is HTTPS-only
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ── Feature flags ────────────────────────────────────────────────────────────
FEATURE_REVIEWS=False
FEATURE_WISHLIST=False
FEATURE_DISCOUNT_CODES=False

# ── Gunicorn ─────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=3

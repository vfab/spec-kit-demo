# Development environment settings
# Copy to .env (or export these variables) for local development.
# This file is safe to commit — it contains no secrets, only defaults.

# ── Core ──────────────────────────────────────────────────────────────────────
# Generate a local key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dev-secret-key-replace-me

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite — zero-config, file lives at project root
DATABASE_URL=sqlite:///db.sqlite3
DB_CONN_MAX_AGE=0

# ── Email ────────────────────────────────────────────────────────────────────
# Prints emails to the terminal instead of sending them
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ── Static / media ───────────────────────────────────────────────────────────
STATIC_URL=/static/
MEDIA_URL=/media/

# ── Business logic ───────────────────────────────────────────────────────────
TAX_RATE=0.08
MAX_IMAGE_UPLOAD_MB=5

# ── Security (relaxed for local HTTP) ────────────────────────────────────────
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ── Feature flags ────────────────────────────────────────────────────────────
FEATURE_REVIEWS=False
FEATURE_WISHLIST=False
FEATURE_DISCOUNT_CODES=False
